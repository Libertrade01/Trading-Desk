# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public app URL for auth email redirects (production)
NEXT_PUBLIC_APP_URL=https://libertrade-desk.vercel.app

# Optional: apply branded email templates via scripts/apply-supabase-email-templates.mjs
# SUPABASE_ACCESS_TOKEN=
# RESEND_API_KEY=
# AUTH_FROM_EMAIL=noreply@libertrade.com
# AUTH_SENDER_NAME=Libertrade

# Founder account — orphan rows are assigned to this user on first login
FOUNDER_EMAIL=midefi@protonmail.com

# Set to true to bypass auth in middleware (local dev only)
AUTH_DISABLED=false

# Feature flags (default on when unset)
NEXT_PUBLIC_FEATURE_WIKI=true
NEXT_PUBLIC_FEATURE_LEGACY_DESK=true

# Cron / external APIs
CRON_SECRET=
FMP_API_KEY=
