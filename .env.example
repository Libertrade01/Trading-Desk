# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public app URL for auth email redirects (production)
# One Vercel project: libertrade-app. Founder-only Wiki and Trade Desk access is
# granted server-side to FOUNDER_EMAIL; keep both public feature flags false.
NEXT_PUBLIC_APP_URL=https://libertrade.app

# Optional: apply branded email templates via scripts/apply-supabase-email-templates.mjs
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=YOUR-PROJECT-REF
# RESEND_API_KEY=
# AUTH_FROM_EMAIL=support@libertrade.app
# AUTH_SENDER_NAME=Libertrade

# Founder account — orphan rows are assigned to this user on first login
FOUNDER_EMAIL=you@example.com

# Optional founder Admin traffic panel (server-only Vercel Web Analytics API)
# Create a scoped Vercel access token; never prefix these with NEXT_PUBLIC_.
VERCEL_ANALYTICS_TOKEN=
VERCEL_ANALYTICS_PROJECT_ID=
VERCEL_ANALYTICS_TEAM_ID=

# Set to true to bypass auth in middleware (local dev only)
AUTH_DISABLED=false

# Feature flags (default on when unset)
NEXT_PUBLIC_FEATURE_WIKI=true
NEXT_PUBLIC_FEATURE_LEGACY_DESK=true

# Cron / external APIs
CRON_SECRET=
FMP_API_KEY=

# Login with ChatGPT (AI Assistant) — stable secret for session cookies + token encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LWC_SECRET=
